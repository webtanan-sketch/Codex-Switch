{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Account Manager",
  "version": "0.1.2",
  "identifier": "com.webtanan.codex-account-manager",
  "build": { "beforeDevCommand": "npm run dev --workspace @codex-manager/desktop", "beforeBuildCommand": "npm run build --workspace @codex-manager/desktop", "devUrl": "http://localhost:1420", "frontendDist": "../dist" },
  "app": { "windows": [{ "label": "main", "title": "Codex Account Manager", "width": 1120, "height": 780, "minWidth": 760, "minHeight": 600 }], "security": { "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self'; connect-src ipc: http://ipc.localhost" } },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"], "shortDescription": "Local Codex account manager", "windows": { "nsis": { "installMode": "currentUser", "languages": ["English"], "displayLanguageSelector": false } } }
}
